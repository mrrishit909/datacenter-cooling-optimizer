 "components": {
  "schemas": {
   "ApproveIn": {
    "properties": {
     "note": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "note"
    ],
    "title": "ApproveIn"
   },
   "CoolIn": {
    "properties": {
     "facility_id": {
      "type": "string",
      "format": "uuid",
      "title": "Facility Id"
     }
    },
    "type": "object",
    "required": [
     "facility_id"
    ],
    "title": "CoolIn"
   },
   "EventIn": {
    "properties": {
     "facility_id": {
      "type": "string",
      "format": "uuid",
      "title": "Facility Id"
     },
     "kind": {
      "type": "string",
      "pattern": "^crac_failure$",
      "title": "Kind",
      "default": "crac_failure"
     },
     "unit": {
      "type": "string",
      "pattern": "^CRAC-[1-4]$",
      "title": "Unit"
     }
    },
    "type": "object",
    "required": [
     "facility_id",
     "unit"
    ],
    "title": "EventIn"
   },
   "FitIn": {
    "properties": {
     "facility_id": {
      "type": "string",
      "format": "uuid",
      "title": "Facility Id"
     }
    },
    "type": "object",
    "required": [
     "facility_id"
    ],
    "title": "FitIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Job": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "title": "Name"
     },
     "servers": {
      "type": "integer",
      "maximum": 16.0,
      "minimum": 1.0,
      "title": "Servers"
     },
     "priority": {
      "type": "integer",
      "maximum": 9.0,
      "minimum": 0.0,
      "title": "Priority",
      "default": 1
     }
    },
    "type": "object",
    "required": [
     "name",
     "servers"
    ],
    "title": "Job"
   },
   "LoadIn": {
    "properties": {
     "external_ref": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "title": "External Ref"
     },
     "name": {
      "type": "string",
      "maxLength": 120,
      "title": "Name",
      "default": "Hall 1"
     },
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 19
     }
    },
    "type": "object",
    "required": [
     "external_ref"
    ],
    "title": "LoadIn"
   },
   "PlaceIn": {
    "properties": {
     "facility_id": {
      "type": "string",
      "format": "uuid",
      "title": "Facility Id"
     },
     "jobs": {
      "items": {
       "$ref": "#/components/schemas/Job"
      },
      "type": "array",
      "maxItems": 20,
      "minItems": 1,
      "title": "Jobs"
     }
    },
    "type": "object",
    "required": [
     "facility_id",
     "jobs"
    ],
